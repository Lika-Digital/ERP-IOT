#!/usr/bin/env bash
# ERP-IOT · run one command as the app (user erp, its environment and secrets).
#
#   sudo ~/erp-iot/deploy/erp-run alembic upgrade head
#   sudo ~/erp-iot/deploy/erp-run alembic current
#   sudo ~/erp-iot/deploy/erp-run python -m app.setup_admin --email you@x --base-url http://100.x.y.z
#
# The secrets go to the command the same way as to erp-iot.service: systemd
# hands them over (LoadCredential) for this one process; they are never printed,
# never in a file the erp user can read, never in this shell's environment.
# Runs in /opt/erp-iot/backend with its venv first on PATH.
set -euo pipefail
[ "$(id -u)" -eq 0 ] || { echo "run with sudo" >&2; exit 2; }
[ $# -ge 1 ] || { echo "usage: sudo erp-run <command> [args...]" >&2; exit 2; }

exec systemd-run --quiet --pipe --wait --collect --service-type=exec \
    -p User=erp -p Group=erp \
    -p WorkingDirectory=/opt/erp-iot/backend \
    -p EnvironmentFile=/etc/erp-iot/erp-iot.env \
    -p "Environment=PYTHONDONTWRITEBYTECODE=1 PATH=/opt/erp-iot/backend/.venv/bin:/usr/bin:/bin" \
    -p "Environment=DATABASE_URL=postgresql+psycopg2://erp@/erp_iot?host=/var/run/postgresql" \
    -p LoadCredential=jwt_secret:/etc/erp-iot/jwt_secret \
    -p LoadCredential=erp_encryption_key:/etc/erp-iot/erp_encryption_key \
    /bin/sh -c 'JWT_SECRET="$(cat "$CREDENTIALS_DIRECTORY/jwt_secret")" ERP_ENCRYPTION_KEY="$(cat "$CREDENTIALS_DIRECTORY/erp_encryption_key")" exec "$@"' erp-run "$@"
