# ERP-IOT Backend Environment Variables
# Copy this file to .env and fill in real values before running.

# ── Database ──────────────────────────────────────────────────────────────────
# OBVEZNO. Prazno = aplikacija i migracije se NE DIZU (spec §11 O16).
# Oblik: postgresql://erp_user:<lozinka>@localhost:5432/erp_iot
DATABASE_URL=

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
# OBVEZNO. Prazno = aplikacija se NE DIZE (namjerno, spec §7.1).
# Generiraj: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# JWT expiry in minutes (default 480 = 8 hours)
JWT_EXPIRE_MINUTES=480

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173

# ── App ───────────────────────────────────────────────────────────────────────
# nginx je jedini javni slusatelj (spec §8.1)
APP_HOST=127.0.0.1
APP_PORT=8000

# ── Users (D20) ───────────────────────────────────────────────────────────────
# Nema DEFAULT_ADMIN_PASSWORD. Prvi admin dobiva jednokratni link (30 min):
#   python -m app.setup_admin --email admin@marina.hr
# Adresa na kojoj se UI otvara — ide u jednokratne linkove.
PUBLIC_BASE_URL=http://localhost:5173

# ── Pedestal API ──────────────────────────────────────────────────────────────
# Default timeouts/retries (override per-marina in DB)
PEDESTAL_API_TIMEOUT_SECONDS=10
PEDESTAL_API_MAX_RETRIES=3

# ── Service account password encryption ──────────────────────────────────────
# Fernet symmetric key for encrypting service account passwords at rest.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: if you change this key, all stored passwords become unreadable.
# Generiraj: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ERP_ENCRYPTION_KEY=

# D21 layer 2 - decoys (spec 7.1, 13.1): comma-separated; empty = that decoy is off.
# Nobody legitimate uses them; a sign-in or a webhook with one is recorded in decoy_hits.
DECOY_ACCOUNT_EMAILS=
DECOY_API_KEYS=
